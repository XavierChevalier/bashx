#!/usr/bin/env bash
# bashx: test framework, coverage and mutation testing for bash.
# https://github.com/XavierChevalier/bashx
set -euo pipefail

BASHX_VERSION="0.1.1" # x-release-please-version

# The lib dir, following symlinks (bashx installed as a link in ~/.local/bin).
bashx::lib_dir() {
  local self="${BASH_SOURCE[0]}"
  while [[ -L "${self}" ]]; do
    local target
    target="$(readlink "${self}")"
    [[ "${target}" == /* ]] || target="$(dirname "${self}")/${target}"
    self="${target}"
  done
  cd "$(dirname "${self}")/../lib" && pwd
}

bashx::usage() {
  cat <<USAGE
bashx ${BASHX_VERSION}: tests, coverage and mutation testing for bash

Usage: bashx <command> [options]

  test [<root>]            run every *.test.sh under <root>
  test --coverage=DIR      ... and measure line coverage
  coverage report <tsv>    score a coverage run again (filters, formats)
  mutate <script.sh>...    mutation testing: do the tests notice a change?
  lib                      print the lib dir, for: source "\$(bashx lib)/bashx.sh"
  version                  print the version

\`bashx <command> --help\` details each command. Docs: docs/ in the repository.
USAGE
}

main() {
  local -r lib="$(bashx::lib_dir)"
  local -r cmd="${1:-help}"
  (($# == 0)) || shift
  export BASHX_LIB="${lib}"
  case "${cmd}" in
    test) exec bash "${lib}/runner.sh" "$@" ;;
    mutate) exec bash "${lib}/mutation.sh" "$@" ;;
    coverage) exec bash "${lib}/coverage.sh" "$@" ;;
    lib) echo "${lib}" ;;
    version | --version | -v) echo "bashx ${BASHX_VERSION}" ;;
    help | --help | -h) bashx::usage ;;
    *)
      echo "bashx: unknown command '${cmd}'" >&2
      bashx::usage >&2
      return 2
      ;;
  esac
}

main "$@"
