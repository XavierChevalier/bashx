#!/usr/bin/env bash
# bashx: test framework, coverage and mutation testing for bash.
# https://github.com/XavierChevalier/bashx
#
# The commands are a Go program (cmd/bashx); this launcher finds the binary
# for this version and runs it. In order:
#   1. $BASHX_BIN, when set;
#   2. in a checkout with Go installed: built from source into .build/,
#      rebuilt whenever a source file is newer than it;
#   3. libexec/bashx-<os>-<arch>, shipped in the release archive;
#   4. downloaded once from the GitHub release of this version
#      ($BASHX_RELEASES_URL) into ${XDG_CACHE_HOME:-~/.cache}/bashx/<version>/
#      (curl or wget, checked against its .sha256).
# `bashx lib` and `bashx version` answer without the binary.
set -euo pipefail

BASHX_VERSION="0.1.1" # x-release-please-version
# Where release binaries are downloaded from: <url>/v<version>/bashx-<os>-<arch>.
BASHX_RELEASES_URL="${BASHX_RELEASES_URL:-https://github.com/XavierChevalier/bashx/releases/download}"

# The bashx root, following symlinks (bashx installed as a link in ~/.local/bin).
bashx::root() {
  local self="${BASH_SOURCE[0]}"
  while [[ -L "${self}" ]]; do
    local target
    target="$(readlink "${self}")"
    [[ "${target}" == /* ]] || target="$(dirname "${self}")/${target}"
    self="${target}"
  done
  cd "$(dirname "${self}")/.." && pwd
}

# <os>-<arch> as Go names them: linux-amd64, darwin-arm64...
bashx::platform() {
  local os arch
  os="$(uname -s | tr '[:upper:]' '[:lower:]')"
  arch="$(uname -m)"
  case "${arch}" in
    x86_64 | amd64) arch=amd64 ;;
    aarch64 | arm64) arch=arm64 ;;
  esac
  echo "${os}-${arch}"
}

# Builds <root>/.build/bashx when missing or older than a source file.
# Usage: bashx::build <root>
bashx::build() {
  local -r root="$1"
  local -r bin="${root}/.build/bashx"
  if [[ -x "${bin}" ]] && [[ -z "$(find "${root}/cmd" "${root}/go.mod" -newer "${bin}" -print -quit 2>/dev/null)" ]]; then
    echo "${bin}"
    return 0
  fi
  mkdir -p "${root}/.build"
  # Built aside, then moved: parallel test files may build at the same time.
  local -r tmp="$(mktemp "${root}/.build/bashx.XXXXXX")"
  if ! (cd "${root}" && CGO_ENABLED=0 go build -trimpath -ldflags "-s -w -X main.version=${BASHX_VERSION}" \
    -o "${tmp}" ./cmd/bashx) >&2; then
    rm -f -- "${tmp}"
    echo "bashx: could not build ${root}/cmd/bashx" >&2
    return 1
  fi
  mv -f -- "${tmp}" "${bin}"
  echo "${bin}"
}

# Downloads <url> to <file> with curl or wget.
# Usage: bashx::fetch <url> <file>
bashx::fetch() {
  if command -v curl >/dev/null 2>&1; then
    curl -fsSL -o "$2" "$1"
  elif command -v wget >/dev/null 2>&1; then
    wget -q -O "$2" "$1"
  else
    echo "bashx: curl or wget is needed to download $1" >&2
    return 1
  fi
}

# SHA-256 of <file>.
bashx::sha256() {
  if command -v sha256sum >/dev/null 2>&1; then
    sha256sum "$1" | awk '{ print $1 }'
  else
    shasum -a 256 "$1" | awk '{ print $1 }'
  fi
}

# Downloads the release binary of this version for <platform> into the cache.
# Usage: bashx::download <platform>
bashx::download() {
  local -r platform="$1"
  local -r dir="${XDG_CACHE_HOME:-${HOME}/.cache}/bashx/${BASHX_VERSION}"
  local -r bin="${dir}/bashx-${platform}"
  if [[ -x "${bin}" ]]; then
    echo "${bin}"
    return 0
  fi
  local -r url="${BASHX_RELEASES_URL}/v${BASHX_VERSION}/bashx-${platform}"
  mkdir -p "${dir}"
  local -r tmp="$(mktemp "${dir}/bashx.XXXXXX")"
  echo "bashx: downloading ${url}" >&2
  if ! bashx::fetch "${url}" "${tmp}" || ! bashx::fetch "${url}.sha256" "${tmp}.sha256"; then
    rm -f -- "${tmp}" "${tmp}.sha256"
    echo "bashx: no bashx ${BASHX_VERSION} binary for ${platform}; install Go to build it (https://go.dev/dl/)" >&2
    return 1
  fi
  local want got
  want="$(awk '{ print $1; exit }' "${tmp}.sha256")"
  got="$(bashx::sha256 "${tmp}")"
  rm -f -- "${tmp}.sha256"
  if [[ "${want}" != "${got}" ]]; then
    rm -f -- "${tmp}"
    echo "bashx: checksum mismatch for ${url}" >&2
    return 1
  fi
  chmod +x "${tmp}"
  mv -f -- "${tmp}" "${bin}"
  echo "${bin}"
}

# Path of the bashx binary to run.
# Usage: bashx::binary <root>
bashx::binary() {
  local -r root="$1"
  if [[ -n "${BASHX_BIN:-}" ]]; then
    echo "${BASHX_BIN}"
    return 0
  fi
  if [[ -f "${root}/go.mod" ]] && command -v go >/dev/null 2>&1; then
    bashx::build "${root}"
    return
  fi
  local -r platform="$(bashx::platform)"
  if [[ -x "${root}/libexec/bashx-${platform}" ]]; then
    echo "${root}/libexec/bashx-${platform}"
    return 0
  fi
  bashx::download "${platform}"
}

main() {
  local root
  root="$(bashx::root)"
  export BASHX_LIB="${root}/lib"
  case "${1:-}" in
    lib)
      echo "${BASHX_LIB}"
      return 0
      ;;
    version | --version | -v)
      echo "bashx ${BASHX_VERSION}"
      return 0
      ;;
  esac
  local bin
  bin="$(bashx::binary "${root}")"
  exec "${bin}" "$@"
}

main "$@"
